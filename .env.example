## MONGODB
MONGO_PORT='27017'
MONGO_HOST='infra-mongodb'
MONGO_INITDB_ROOT_USERNAME='changeme'
MONGO_INITDB_ROOT_PASSWORD='changeme'
MONGO_INITDB_DATABASE='testdb'

## RabbitMQ
RABBITMQ_PORT='5672'
RABBITMQ_SCHEMA='amqp'
RABBITMQ_HOST='infra-rabbitmq'
RABBITMQ_DEFAULT_USER='guest'
RABBITMQ_DEFAULT_PASS='changeme'
RABBITMQ_DEFAULT_VHOST='/'

## Elasticsearch + Kibana (migrated from trident)
ELASTIC_PASSWORD=change-me-to-a-strong-random-value
KIBANA_PASSWORD=change-me-to-a-different-strong-random-value

## RabbitMQ vhost for trident/web-hunting (dedicated, not the default guest/vhost)
WEBHUNTING_RABBITMQ_USER=web-hunting
WEBHUNTING_RABBITMQ_PASSWORD=change-me-to-a-strong-random-value

## RabbitMQ vhost for cve-trove (dedicated, not the default guest/vhost)
CVETROVE_RABBITMQ_USER=cve-trove
CVETROVE_RABBITMQ_PASSWORD=change-me-to-yet-another-strong-random-value
